<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.pcremote.net"
>

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />
    <!-- pair once for every app: «Мой ПК» shares its pairing with our other apps (same signing key only) -->
    <permission android:name="ru.pcremote.permission.PAIRING" android:protectionLevel="signature" />
    <uses-permission android:name="ru.pcremote.permission.PAIRING" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: update itself without the "Install?" question, on its own, without «Мой ПК» -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- the per-app list ("these apps go direct"): a VPN app may see what is installed -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="Интернет через ПК"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".PcVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <service
            android:name=".NetTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="Через ПК"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <provider
            android:name=".ApkProvider"
            android:authorities="ru.pcremote.net.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- a silent self-update restarts the process: the tunnel comes back by itself -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".NetInstaller" android:exported="false" />
        <receiver android:name=".NetPairApprove" android:exported="false" />
        <!-- «Мой ПК» asks us to update it; only our own apps hold PAIRING -->
        <receiver android:name=".NetPartnerUpdate" android:exported="true" android:permission="ru.pcremote.permission.PAIRING">
            <intent-filter>
                <action android:name="ru.pcremote.net.UPDATE_PARTNER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
